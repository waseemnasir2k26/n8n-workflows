{
  "name": "S09 Car service reminders (simulated SMS)",
  "nodes": [
    {
      "parameters": {
        "content": "## What this does\n\nEvery morning it reads your job sheet, finds customers whose last service was 6+ months ago and who have not been reminded, and texts them a booking link. It then writes the reminder date back so nobody is texted twice.",
        "height": 300,
        "width": 460,
        "color": 4
      },
      "id": "sticky-1",
      "name": "What this does",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1000,
        -420
      ]
    },
    {
      "parameters": {
        "content": "## Setup in 4 steps\n\n1. Import and connect Google Sheets and Twilio credentials.\n2. Sheet tab 'jobs' with columns: job_id, name, phone, last_service (YYYY-MM-DD), reminded_at.\n3. Replace the sheet id, your Twilio number and the booking link.\n4. Test with one row, then enable the SMS node.",
        "height": 300,
        "width": 460,
        "color": 5
      },
      "id": "sticky-2",
      "name": "Setup in 4 steps",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -520,
        -420
      ]
    },
    {
      "parameters": {
        "content": "## Safety: SIMULATED + cap 50\n\nSIMULATED - enable after credentials. The SMS node is disabled. A Limit node caps every run at 50 customers, and reminded_at stops repeats. Check SMS consent rules in your country before going live.",
        "height": 300,
        "width": 460,
        "color": 3
      },
      "id": "sticky-3",
      "name": "Safety: SIMULATED + cap 50",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -420
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "sched",
      "name": "Every day 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -900,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_ME"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "jobs"
        },
        "options": {}
      },
      "id": "read",
      "name": "Read job sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -640,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "d1",
              "leftValue": "={{ (Date.now() - new Date($json.last_service).getTime()) / 86400000 }}",
              "rightValue": 182,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "d2",
              "leftValue": "={{ $json.reminded_at }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "due",
      "name": "6+ months and not reminded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -380,
        0
      ]
    },
    {
      "parameters": {
        "maxItems": 50
      },
      "id": "cap",
      "name": "Cap 50 per run",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        -120,
        0
      ]
    },
    {
      "parameters": {
        "from": "+1 555 010 0000",
        "to": "={{ $json.phone }}",
        "message": "=Hi {{ $json.name }}, it has been 6 months since your last service. Book your slot here: https://example.com/book"
      },
      "id": "sms",
      "name": "SMS reminder (simulated)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        140,
        0
      ],
      "credentials": {
        "twilioApi": {
          "name": "Twilio account"
        }
      },
      "disabled": true
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_ME"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "jobs"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "job_id": "={{ $('Cap 50 per run').item.json.job_id }}",
            "reminded_at": "={{ $now.toISODate() }}"
          },
          "matchingColumns": [
            "job_id"
          ],
          "schema": []
        },
        "options": {}
      },
      "id": "mark",
      "name": "Mark reminded",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Every day 08:00": {
      "main": [
        [
          {
            "node": "Read job sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read job sheet": {
      "main": [
        [
          {
            "node": "6+ months and not reminded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cap 50 per run": {
      "main": [
        [
          {
            "node": "SMS reminder (simulated)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMS reminder (simulated)": {
      "main": [
        [
          {
            "node": "Mark reminded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "6+ months and not reminded?": {
      "main": [
        [
          {
            "node": "Cap 50 per run",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all"
  },
  "active": false
}