{
  "name": "WF-00 Workflow Library Signup",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "workflow-signup",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://workflows.skynetjoe.com",
          "ignoreBots": false
        }
      },
      "name": "Signup Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// WF-00 Workflow Library Signup - validate input\nconst item = $input.first().json;\nlet body = item.body || {};\nconst headers = item.headers || {};\n// curl -d '{\"...\"}' without a content-type header arrives as a form-encoded key with an empty value\nif (!body.email) {\n  for (const k of Object.keys(body)) {\n    const key = String(k).trim();\n    if (key.charAt(0) === \"{\") {\n      try {\n        const parsed = JSON.parse(key);\n        if (parsed && typeof parsed === \"object\") {\n          body = parsed;\n          // form-decoding turned \"+\" into \" \" inside the raw JSON; a space is never valid in an email\n          if (typeof body.email === \"string\") body.email = body.email.replace(/ /g, \"+\");\n          break;\n        }\n      } catch (e) {}\n    }\n  }\n}\nconst emailRaw = typeof body.email === \"string\" ? body.email : \"\";\nconst email = emailRaw.trim().toLowerCase();\nconst honeypot = typeof body.website === \"string\" ? body.website.trim() : \"\";\nconst re = /^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$/;\nconst valid =\n  email.length > 3 && email.length <= 254 && re.test(email) && honeypot === \"\";\nconst fwd = String(\n  headers[\"x-forwarded-for\"] ||\n    headers[\"cf-connecting-ip\"] ||\n    headers[\"x-real-ip\"] ||\n    \"\",\n);\nconst ip = fwd.split(\",\")[0].trim().slice(0, 64) || null;\nconst ua = String(headers[\"user-agent\"] || \"\").slice(0, 300) || null;\nconst source =\n  typeof body.source === \"string\" && body.source.trim()\n    ? body.source.trim().slice(0, 64)\n    : \"unknown\";\nconst slug =\n  typeof body.workflow_slug === \"string\" && body.workflow_slug.trim()\n    ? body.workflow_slug.trim().slice(0, 80)\n    : null;\nreturn [\n  {\n    json: {\n      ok: valid,\n      error: valid ? null : honeypot ? \"honeypot\" : \"invalid_email\",\n      email,\n      source,\n      workflow_slug: slug,\n      ip,\n      user_agent: ua,\n    },\n  },\n];\n"
      },
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": false, \"error\": \"invalid_email\"}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "responseCode": 400
        }
      },
      "name": "Respond 400 Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        520
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_subscribers (email, source, workflow_slug, ip, user_agent)\nVALUES ($1, $2, $3, $4, $5)\nON CONFLICT (email) DO UPDATE SET\n  last_seen_at = now(),\n  source = EXCLUDED.source,\n  workflow_slug = COALESCE(EXCLUDED.workflow_slug, workflow_subscribers.workflow_slug),\n  unsubscribed_at = NULL\nRETURNING id, (xmax = 0) AS is_new;",
        "options": {
          "queryReplacement": "={{ [ $json.email, $json.source, $json.workflow_slug, $json.ip, $json.user_agent ] }}"
        }
      },
      "name": "Upsert Subscriber",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Your Postgres"
        }
