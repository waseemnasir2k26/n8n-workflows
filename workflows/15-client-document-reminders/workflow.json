        "emailType": "text",
        "message": "=Hi {{ $json.client_name }},\n\nWe reminded you on Monday and still do not have your {{ $json.document }}. Without it we cannot file on time. Please send it by end of day tomorrow.\n\nThank you,\nSkyline Bookkeeping (demo)",
