          "conditions": [
            {
              "id": "0d4a0820-559a-4673-8e8a-938c7c537e29",
              "leftValue": "={{ String($json.doc_received).toLowerCase() }}",
              "rightValue": "no",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.reminded_at }}",
              "rightValue": "",
